{
  "manifest_version": 3,
  "name": "Timestamp Tooltip",
  "version": "1.0",
  "description": "Converts timestamps into human-readable form with tooltips",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "notifications"
  ],
  "background": {
    "service_worker": "main.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Timestamp Tooltip",
    "default_icon": {
      "128": "assets/iconteal.png"
    }
  },
  "icons": {
    "128": "assets/iconteal.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
